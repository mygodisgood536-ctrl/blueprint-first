# Blueprint-First platform configuration
#
# Copy to `.env` and fill in real values. NEVER commit a real `.env` file.
#
# Secret boundary: every value below is read from the process environment at call
# time on the server only. Secrets are never written into source control, the
# frontend bundle, evidence records, or logs. In production (Vercel) these live
# in the project's environment variables, never in the repository.
#
# The list below is derived from the variables the server actually reads. A
# variable that is absent is reported honestly rather than assumed satisfied —
# see `GET /api/health`, which reports the live persistence backend and whether
# the deployment is genuinely ready.

# ─── Core ────────────────────────────────────────────────────────────────────
# development | production | serverless
BF_ENV=development
# trace | debug | info | warn | error | silent
BF_LOG_LEVEL=info
# Local filesystem state root. Ignored in production, where PostgreSQL is the
# substrate; kept for development and the test suite.
BF_DATA_DIR=./data

# ─── Durable persistence (Neon / PostgreSQL) ────────────────────────────────
# Production MUST be database-backed: Vercel has no durable disk, so a deploy
# without this would lose every project on the next cold start.
# `DATABASE_URL` is canonical; `POSTGRES_URL`, `NEON_DATABASE_URL` and
# `PGDATABASE_URL` are honoured as aliases for Neon connection strings.
DATABASE_URL=
# NEON_DATABASE_URL=
# POSTGRES_URL=
# Set to 1 in production to remove the filesystem fallback entirely. The boot
# then FAILS rather than quietly degrading to an ephemeral disk, so a
# misconfigured deploy is caught immediately instead of losing work silently.
BF_REQUIRE_DATABASE=

# ─── Scheduled supervision watchdog ─────────────────────────────────────────
# The watchdog keeps the three-minute no-progress timeout, crash recovery and
# network-restore resume working on a serverless control plane, where there is
# no long-lived daemon. Vercel's scheduler sends `Authorization: Bearer
# $CRON_SECRET` automatically when CRON_SECRET is set. If neither secret is
# configured the tick is REFUSED (503) rather than exposed publicly.
CRON_SECRET=
# Optional explicit secret for schedulers other than Vercel's.
BF_WATCHDOG_SECRET=

# ─── Local process binding (development only) ────────────────────────────────
BF_WEB_HOST=127.0.0.1
BF_WEB_PORT=3000
# `serverless` disables the in-process supervisor interval loops so a frozen
# function does not spawn competing supervisors; the scheduled watchdog drives
# supervision instead. Automatically set on Vercel.
BF_SUPERVISOR_MODE=

# ─── AI routing ─────────────────────────────────────────────────────────────
# Built-in providers: scripted | openai-compatible
BF_AI_DEFAULT_PROVIDER=scripted
# Optional per-task overrides, comma-separated TASK=PROVIDER, e.g.
# BF_AI_ROUTING=DISCOVERY=openai-compatible,DESIGN=openai-compatible
BF_AI_ROUTING=

# ─── openai-compatible provider ─────────────────────────────────────────────
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_API_KEY=

# ─── OpenRouter (optional hosted-provider catalogue) ─────────────────────────
OPENROUTER_API_KEY=

# ─── OpenCode (authoritative provider/model integration) ────────────────────
# OpenCode is the platform's authoritative provider/model source. The provider
# and model catalogue, their pricing, and the account's CURRENT model
# availability all come from OpenCode - never from a list frozen in this
# repository - so a model OpenCode withdraws stops being offered without any
# code change here.
#
# OPENCODE_API_KEY is the OpenCode CONSOLE token. It is a server-side secret:
# it is never sent to a browser, never logged, never written to evidence, and
# never committed. The platform uses it to read the account's current model
# list and to execute the selected model against the endpoint OpenCode
# publishes for it.
OPENCODE_API_KEY=
#
# Leave OPENCODE_BIN unset to auto-discover the `opencode` binary on PATH. It is
# optional: a managed control plane has no native OpenCode binary, and the
# console above is the execution path there.
OPENCODE_BIN=

# ─── Cline (mandatory Worker/agent execution layer) ─────────────────────────
# Cline performs the engineering actions against the real project environment;
# the platform observes the real files, commands and processes it produced.
# Leave CLINE_BIN unset to use `cline` from PATH. CLINE_BASE_URL is only needed
# when Cline runs as a remote service.
CLINE_BIN=
CLINE_BASE_URL=

# ─── Daytona (mandatory project execution environment) ──────────────────────
# Daytona API base. `BF_DAYTONA_API_KEY` is an OWNER-ONLY secret: it is written
# through the Platform Owner's infrastructure boundary and must never appear in
# source control, the frontend bundle, logs, or any user-visible response. An
# ordinary account receives an authorization failure, never a hidden control.
DAYTONA_API_URL=https://app.daytona.io
BF_DAYTONA_API_KEY=

# ─── Platform Owner bootstrap (V.4) ─────────────────────────────────────────
# The Platform Owner account is provisioned server-side during secure
# initialization; it does not require public signup and uses the same public
# login screen as every other account. The identity is reserved so no other
# account can claim it.
#
# Only the SECURITY ANSWER is genuinely secret. It MUST NOT be placed in this
# file with a real value, in source control, in the frontend bundle, or in logs.
# Supply it through the deployment's secret store at boot.
BF_BOOTSTRAP_FULL_NAME=
BF_BOOTSTRAP_USERNAME=
BF_BOOTSTRAP_GMAIL=
BF_BOOTSTRAP_SECURITY_QUESTION=
BF_BOOTSTRAP_SECURITY_ANSWER=