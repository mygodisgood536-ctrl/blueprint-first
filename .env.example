# Blueprint-First platform configuration
# Copy to `.env` and fill in real values. NEVER commit a real .env file.
# Secrets are read from the environment at call time; they must never be
# hard-coded or logged. See docs/configuration.md.

# --- Core ---
BF_ENV=development
BF_LOG_LEVEL=info
BF_DATA_DIR=./data

# --- AI routing ---
# Default provider used when no task-specific rule matches.
# Built-in providers: scripted | openai-compatible
BF_AI_DEFAULT_PROVIDER=scripted
# Optional per-task overrides, comma-separated TASK=PROVIDER pairs, e.g.:
# BF_AI_ROUTING=DISCOVERY=openai-compatible,DESIGN=openai-compatible
BF_AI_ROUTING=

# --- openai-compatible provider ---
# Base URL of an OpenAI-compatible chat-completions endpoint.
OPENAI_COMPATIBLE_BASE_URL=
# Model identifier to request from the endpoint.
OPENAI_COMPATIBLE_MODEL=
# Secret API key. Resolved from the environment at request time only.
OPENAI_COMPATIBLE_API_KEY=
