{
  "name": "blueprint-first",
  "version": "3.3.0",
  "description": "Blueprint-First — an AI software engineering platform that discovers, designs, builds, verifies, certifies and operates software through a governed, evidence-backed engineering organization.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test",
    "demo": "node src/demo/main.ts",
    "dev": "node src/web/server.ts",
    "dev:web": "npm --prefix design-prototype run dev",
    "build:frontend": "npm --prefix design-prototype run build:serve"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "express": "^5.2.1",
    "pg": "^8.23.1"
  }
}
